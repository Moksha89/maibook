/* ============================================
   MIBOOK.DEV - Modern Admin Theme
   Inspired by LIBRA Dashboard Reference
   ============================================ */

/* ---------- Google Font ---------- */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

/* ---------- CSS Variables ---------- */
:root {
  --sidebar-bg: #ffffff;
  --sidebar-hover: #f4f6fa;
  --sidebar-active-bg: #e8652e;
  --sidebar-text: #6b7280;
  --sidebar-text-hover: #1a1a2e;
  --sidebar-width: 250px;

  --primary: #e8652e;
  --primary-light: #fef0ea;
  --primary-dark: #c74e1a;
  --accent: #e8652e;

  --bg-body: #f4f6fa;
  --bg-white: #ffffff;
  --text-dark: #1a1a2e;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;

  --border-color: #e5e7eb;
  --border-radius: 12px;
  --border-radius-sm: 8px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);

  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --transition: all 0.25s ease;
}

/* ---------- Base ---------- */
body {
  font-family: var(--font-family) !important;
  background: var(--bg-body) !important;
  color: var(--text-dark) !important;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

*, *::before, *::after {
  box-sizing: border-box;
}

/* ---------- Sidebar ---------- */
.sidebar-wrapper {
  background: var(--sidebar-bg) !important;
  width: var(--sidebar-width) !important;
  box-shadow: 1px 0 10px rgba(0,0,0,0.06) !important;
  border-right: 1px solid var(--border-color) !important;
  z-index: 1050 !important;
}

.sidebar-brand {
  background: var(--sidebar-bg) !important;
  padding: 20px 24px !important;
  border-bottom: 1px solid var(--border-color) !important;
  height: auto !important;
  min-height: 70px;
  display: flex !important;
  align-items: center !important;
}

.sidebar-brand a.logo {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  text-decoration: none !important;
}

.sidebar-brand a.logo img {
  height: 36px !important;
  width: auto !important;
  max-width: 160px !important;
  object-fit: contain !important;
  filter: none;
}

.sidebar-menu {
  padding: 16px 0 !important;
  background: transparent !important;
}

.sidebar-menu .sidebarMenuScroll {
  padding: 0 12px !important;
}

.sidebar-menu ul {
  list-style: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

.sidebar-menu ul li {
  margin-bottom: 2px !important;
}

.sidebar-menu ul li a {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  padding: 11px 16px !important;
  border-radius: var(--border-radius-sm) !important;
  color: var(--sidebar-text) !important;
  text-decoration: none !important;
  font-size: 14px !important;
  font-weight: 500 !important;
  transition: var(--transition) !important;
  white-space: nowrap !important;
  overflow: hidden !important;
}

.sidebar-menu ul li a:hover {
  background: var(--sidebar-hover) !important;
  color: var(--sidebar-text-hover) !important;
}

.sidebar-menu ul li a i {
  font-size: 16px !important;
  width: 22px !important;
  text-align: center !important;
  flex-shrink: 0 !important;
  color: inherit !important;
  opacity: 0.8;
}

.sidebar-menu ul li a span.menu-text {
  color: inherit !important;
  font-size: inherit !important;
}

.sidebar-menu ul li.active > a,
.sidebar-menu .active span {
  background: var(--sidebar-active-bg) !important;
  color: #ffffff !important;
  font-weight: 600 !important;
  box-shadow: 0 2px 8px rgba(232, 101, 46, 0.35) !important;
}

.sidebar-menu ul li.active > a i {
  color: #ffffff !important;
  opacity: 1 !important;
}

/* ---------- Main Container ---------- */
.main-container {
  background: var(--bg-body) !important;
  min-height: 100vh;
}

/* ---------- Page Header / Top Bar ---------- */
.page-header {
  background: var(--bg-white) !important;
  border-bottom: 1px solid var(--border-color) !important;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04) !important;
  padding: 0 24px !important;
  height: 56px !important;
  display: flex !important;
  align-items: center !important;
  position: sticky;
  top: 0;
  z-index: 1000;
  gap: 0 !important;
}

/* Toggle sidebar button in header */
.page-header .toggle-sidebar,
.page-header #toggle-sidebar {
  color: var(--text-dark) !important;
  cursor: pointer !important;
  margin-right: 16px !important;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  width: 32px !important;
  height: 32px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 6px !important;
  transition: var(--transition) !important;
  flex-shrink: 0 !important;
}

.page-header .toggle-sidebar:hover,
.page-header #toggle-sidebar:hover {
  background: var(--bg-body) !important;
  color: var(--primary) !important;
}

.page-header .toggle-sidebar i,
.page-header #toggle-sidebar i {
  font-size: 20px !important;
  line-height: 1 !important;
}

/* Mobile logo in header */
.page-header .mobile_logo_none {
  display: none !important;
}

/* Breadcrumbs */
.page-header .breadcrumb {
  margin: 0 !important;
  background: transparent !important;
  padding: 0 !important;
  flex-wrap: nowrap !important;
  white-space: nowrap !important;
}

.page-header .breadcrumb-item {
  display: flex !important;
  align-items: center !important;
}

.page-header .breadcrumb-item i {
  font-size: 14px !important;
  color: var(--text-secondary) !important;
  margin-right: 4px !important;
}

.page-header .breadcrumb-item a {
  color: var(--text-secondary) !important;
  text-decoration: none !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  transition: var(--transition) !important;
}

.page-header .breadcrumb-item a:hover {
  color: var(--primary) !important;
}

.page-header .breadcrumb-item.breadcrumb-active {
  color: var(--text-dark) !important;
  font-weight: 600 !important;
  font-size: 13px !important;
}

.page-header .breadcrumb-item + .breadcrumb-item::before {
  color: var(--text-muted) !important;
  content: "/" !important;
  font-size: 12px !important;
  padding: 0 6px !important;
}

/* Header user actions */
.header-actions-container {
  margin-left: auto !important;
  flex-shrink: 0 !important;
}

.header-actions {
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  display: flex !important;
  align-items: center !important;
  gap: 4px !important;
}

.user-settings {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  text-decoration: none !important;
  padding: 4px 10px !important;
  border-radius: 8px !important;
  transition: var(--transition) !important;
}

.user-settings:hover {
  background: var(--bg-body) !important;
}

.user-settings .user-name {
  color: var(--text-dark) !important;
  font-weight: 600 !important;
  font-size: 13px !important;
}

.user-settings .avatar {
  position: relative !important;
}

.user-settings .avatar img {
  width: 32px !important;
  height: 32px !important;
  border-radius: 8px !important;
  border: 1px solid var(--border-color) !important;
  object-fit: contain !important;
  background: var(--bg-white) !important;
  padding: 2px !important;
}

.user-settings .avatar .status.online {
  background: #22c55e !important;
  width: 8px !important;
  height: 8px !important;
  border-radius: 50% !important;
  border: 1.5px solid var(--bg-white) !important;
  position: absolute !important;
  bottom: -1px !important;
  right: -1px !important;
}

/* Dropdown */
.dropdown-menu {
  border: 1px solid var(--border-color) !important;
  border-radius: var(--border-radius-sm) !important;
  box-shadow: var(--shadow-lg) !important;
  padding: 8px !important;
  margin-top: 8px !important;
}

.header-profile-actions a {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  padding: 8px 14px !important;
  border-radius: 6px !important;
  color: var(--text-dark) !important;
  font-size: 14px !important;
  transition: var(--transition) !important;
  text-decoration: none !important;
}

.header-profile-actions a:hover {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
}

/* ---------- Content Area ---------- */
.content-wrapper-scroll {
  padding: 0 !important;
}

.content-wrapper {
  padding: 28px !important;
}

/* ---------- Cards ---------- */
.card {
  background: var(--bg-white) !important;
  border: 1px solid var(--border-color) !important;
  border-radius: var(--border-radius) !important;
  box-shadow: var(--shadow-sm) !important;
  transition: var(--transition) !important;
  overflow: hidden;
}

.card:hover {
  box-shadow: var(--shadow-md) !important;
}

.card-body {
  padding: 24px !important;
}

.card-title {
  margin-bottom: 20px !important;
}

.card-title h5,
h5.emp-del-title {
  font-size: 18px !important;
  font-weight: 700 !important;
  color: var(--text-dark) !important;
  margin: 0 !important;
}

.btns-back-edit {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
}

/* ---------- Tables ---------- */
.table {
  border-collapse: separate !important;
  border-spacing: 0 !important;
  width: 100% !important;
}

.table thead th {
  background: var(--bg-body) !important;
  color: var(--text-secondary) !important;
  font-weight: 600 !important;
  font-size: 10px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.3px !important;
  padding: 6px 4px !important;
  border-bottom: 2px solid var(--border-color) !important;
  border-top: none !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  max-width: 120px !important;
}

.table tbody td {
  padding: 6px 4px !important;
  font-size: 11px !important;
  color: var(--text-dark) !important;
  border-bottom: 1px solid var(--border-color) !important;
  vertical-align: middle !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  max-width: 120px !important;
  text-align: center !important;
}

/* Prevent DataTables horizontal scroll */
.dataTables_wrapper {
  overflow-x: hidden !important;
}

table.dataTable {
  width: 100% !important;
  table-layout: auto !important;
}

.dataTables_scrollBody,
.table-responsive {
  overflow-x: auto !important;
}

.table tbody tr {
  transition: var(--transition) !important;
}

.table tbody tr:hover {
  background: var(--primary-light) !important;
}

.table-striped > tbody > tr:nth-of-type(odd) > * {
  background: transparent !important;
  --bs-table-accent-bg: transparent !important;
}

.table-striped > tbody > tr:nth-of-type(even) > * {
  background: #fafbfc !important;
  --bs-table-accent-bg: #fafbfc !important;
}

/* DataTables overrides */
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter {
  margin-bottom: 16px !important;
}

.dataTables_wrapper .dataTables_length label,
.dataTables_wrapper .dataTables_filter label {
  font-size: 14px !important;
  color: var(--text-secondary) !important;
  font-weight: 500 !important;
}

.dataTables_wrapper .dataTables_length select {
  padding: 6px 12px !important;
  border: 1px solid var(--border-color) !important;
  border-radius: 6px !important;
  font-size: 14px !important;
  margin: 0 6px !important;
  background: var(--bg-white) !important;
}

.dataTables_wrapper .dataTables_filter input {
  padding: 8px 14px !important;
  border: 1px solid var(--border-color) !important;
  border-radius: var(--border-radius-sm) !important;
  font-size: 14px !important;
  outline: none !important;
  transition: var(--transition) !important;
  min-width: 220px !important;
}

.dataTables_wrapper .dataTables_filter input:focus {
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 3px rgba(232,101,46,0.12) !important;
}

.dataTables_wrapper .dataTables_info {
  font-size: 13px !important;
  color: var(--text-muted) !important;
  padding-top: 16px !important;
}

.dataTables_wrapper .dataTables_paginate {
  padding-top: 16px !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button {
  padding: 6px 14px !important;
  border-radius: 6px !important;
  border: 1px solid var(--border-color) !important;
  font-size: 13px !important;
  font-weight: 500 !important;
  color: var(--text-secondary) !important;
  margin: 0 2px !important;
  transition: var(--transition) !important;
  background: var(--bg-white) !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
  background: var(--primary-light) !important;
  border-color: var(--primary) !important;
  color: var(--primary) !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button.current {
  background: var(--primary) !important;
  border-color: var(--primary) !important;
  color: #ffffff !important;
  font-weight: 600 !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
  background: var(--primary-dark) !important;
  border-color: var(--primary-dark) !important;
  color: #ffffff !important;
}

/* sorting icons */
table.dataTable thead .sorting::before,
table.dataTable thead .sorting::after,
table.dataTable thead .sorting_asc::before,
table.dataTable thead .sorting_asc::after,
table.dataTable thead .sorting_desc::before,
table.dataTable thead .sorting_desc::after {
  opacity: 0.4 !important;
}

table.dataTable thead .sorting_asc::after,
table.dataTable thead .sorting_desc::before {
  opacity: 1 !important;
  color: var(--primary) !important;
}

/* ---------- Buttons ---------- */
.btn {
  font-family: var(--font-family) !important;
  font-weight: 600 !important;
  font-size: 14px !important;
  border-radius: var(--border-radius-sm) !important;
  padding: 8px 20px !important;
  transition: var(--transition) !important;
  border: none !important;
  cursor: pointer;
}

.btn-primary,
.btn-primary:focus,
button.btn.btn-primary {
  background: var(--primary) !important;
  color: #ffffff !important;
  box-shadow: 0 2px 6px rgba(232,101,46,0.25) !important;
}

.btn-primary:hover {
  background: var(--primary-dark) !important;
  box-shadow: 0 4px 12px rgba(232,101,46,0.35) !important;
  transform: translateY(-1px);
}

.btn-secondary {
  background: #f3f4f6 !important;
  color: var(--text-secondary) !important;
  border: 1px solid var(--border-color) !important;
}

.btn-secondary:hover {
  background: #e5e7eb !important;
  color: var(--text-dark) !important;
}

.btn-action .btn {
  padding: 3px 6px !important;
  font-size: 11px !important;
  border-radius: 4px !important;
}

/* Make all action buttons in tables smaller */
.table td .btn,
.table td button,
.table td a.btn,
.btn_color_change .btn {
  padding: 4px 8px !important;
  font-size: 11px !important;
  border-radius: 4px !important;
  line-height: 1 !important;
  min-width: unset !important;
}

.btn_color_change .btn i,
.table td .btn i,
.table td button i,
.table td a i {
  font-size: 12px !important;
}

.btn_color_change .btn-primary.cross {
  background: var(--primary) !important;
}

.btn_color_change .btn-primary.gear {
  background: #ef4444 !important;
  box-shadow: 0 2px 6px rgba(239,68,68,0.25) !important;
}

.btn_color_change .btn-primary.gear:hover {
  background: #dc2626 !important;
}

/* Add company / New Backup button */
.add-company,
button.add-company {
  background: var(--primary) !important;
  color: #ffffff !important;
  border-radius: var(--border-radius-sm) !important;
  padding: 10px 22px !important;
  font-weight: 600 !important;
  box-shadow: 0 2px 8px rgba(232,101,46,0.25) !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
}

.add-company:hover {
  background: var(--primary-dark) !important;
  transform: translateY(-1px);
}

/* ---------- Modals ---------- */
.modal-content {
  border-radius: var(--border-radius) !important;
  border: none !important;
  box-shadow: var(--shadow-lg) !important;
}

.modal-header {
  border-bottom: 1px solid var(--border-color) !important;
  padding: 20px 24px !important;
}

.modal-title {
  font-weight: 700 !important;
  font-size: 18px !important;
  color: var(--text-dark) !important;
}

.modal-body {
  padding: 24px !important;
}

.modal-footer {
  border-top: 1px solid var(--border-color) !important;
  padding: 16px 24px !important;
}

/* ---------- Form Controls ---------- */
.form-control {
  border: 1px solid var(--border-color) !important;
  border-radius: var(--border-radius-sm) !important;
  padding: 10px 14px !important;
  font-size: 14px !important;
  font-family: var(--font-family) !important;
  transition: var(--transition) !important;
  color: var(--text-dark) !important;
}

.form-control:focus {
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 3px rgba(232,101,46,0.12) !important;
  outline: none !important;
}

.form-label {
  font-weight: 600 !important;
  font-size: 13px !important;
  color: var(--text-secondary) !important;
  text-transform: uppercase !important;
  letter-spacing: 0.3px !important;
  margin-bottom: 6px !important;
}

.form-select,
select.form-control {
  border: 1px solid var(--border-color) !important;
  border-radius: var(--border-radius-sm) !important;
  padding: 10px 14px !important;
  font-size: 14px !important;
  font-family: var(--font-family) !important;
}

.form-check-input:checked {
  background-color: var(--primary) !important;
  border-color: var(--primary) !important;
}

/* ---------- Footer ---------- */
.app-footer {
  background: transparent !important;
  border-top: 1px solid var(--border-color) !important;
  padding: 20px 28px !important;
  text-align: center !important;
  color: var(--text-muted) !important;
  font-size: 13px !important;
  font-weight: 500 !important;
}

.app-footer .footer-text {
  color: var(--text-muted) !important;
}

/* Sidebar nav logo (non-sidebar-brand) */
nav.sidebar-wrapper .sidebar-brand img,
nav img[src*="MIBOOKDEV_LOGO"] {
  filter: none !important;
  height: 32px !important;
  width: auto !important;
  max-width: 150px !important;
}

/* Top-right user avatar logo */
.header-actions .user-settings img,
.header-actions img[src*="MIBOOKDEV_LOGO"] {
  filter: none !important;
  width: 32px !important;
  height: 32px !important;
  border-radius: 50% !important;
  border: 2px solid var(--primary-light) !important;
  object-fit: contain !important;
  background: var(--bg-white) !important;
  padding: 2px !important;
}

/* ---------- Loader ---------- */
#loader {
  background-color: rgba(255, 255, 255, 0.95) !important;
}

#loader .spinner {
  border: 3px solid #f3f3f3 !important;
  border-top: 3px solid var(--primary) !important;
  width: 44px !important;
  height: 44px !important;
}

/* ---------- SweetAlert2 overrides ---------- */
.swal2-confirm.swal2-styled {
  background: var(--primary) !important;
  border-radius: var(--border-radius-sm) !important;
  font-family: var(--font-family) !important;
  font-weight: 600 !important;
  padding: 10px 28px !important;
}

.swal2-cancel.swal2-styled {
  border-radius: var(--border-radius-sm) !important;
  font-family: var(--font-family) !important;
  font-weight: 600 !important;
}

/* ---------- Scrollbar ---------- */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #d1d5db;
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: #9ca3af;
}

.sidebar-wrapper::-webkit-scrollbar-thumb {
  background: rgba(0,0,0,0.1);
}

.sidebar-wrapper::-webkit-scrollbar-thumb:hover {
  background: rgba(0,0,0,0.2);
}

/* ---------- Badge / Labels ---------- */
.badge {
  font-weight: 600 !important;
  font-size: 11px !important;
  padding: 4px 10px !important;
  border-radius: 20px !important;
  letter-spacing: 0.3px;
}

.badge-primary,
.bg-primary {
  background: var(--primary) !important;
}

/* ---------- Sidebar Toggle (Desktop) ---------- */
.page-wrapper {
  transition: margin-left 0.3s ease !important;
}

.sidebar-wrapper {
  transition: transform 0.3s ease, width 0.3s ease !important;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  height: 100vh !important;
  overflow-y: auto !important;
}

.page-wrapper.toggled .sidebar-wrapper {
  transform: translateX(-100%) !important;
  width: 0 !important;
  overflow: hidden !important;
}

/* Toggle button - base (overridden by header-specific styles above) */

/* ---------- Responsive ---------- */
@media (max-width: 991px) {
  .sidebar-wrapper {
    transform: translateX(-100%) !important;
  }

  .page-wrapper:not(.toggled) .sidebar-wrapper {
    transform: translateX(-100%) !important;
  }

  .page-wrapper.toggled .sidebar-wrapper {
    transform: translateX(0) !important;
    width: var(--sidebar-width) !important;
    overflow-y: auto !important;
  }

  .content-wrapper {
    padding: 20px 16px !important;
  }

  .page-header {
    padding: 0 16px !important;
  }

  /* Overlay when sidebar is open on mobile */
  .page-wrapper.toggled::after {
    content: '' !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    background: rgba(0,0,0,0.3) !important;
    z-index: 1040 !important;
  }
}

/* ---------- Outer Admin Layout (layouts/admin.blade.php) ---------- */
header.menu-head-sec {
  background: var(--bg-white) !important;
  box-shadow: var(--shadow-sm) !important;
  border-bottom: 1px solid var(--border-color) !important;
}

.navbar-sec nav.navbar.navbar-dark.bg-dark.fixed-top.back-new {
  background: var(--bg-white) !important;
  border-bottom: 1px solid var(--border-color) !important;
}

.navbar-sec a.navbar-brand {
  color: var(--text-dark) !important;
  font-weight: 700 !important;
  font-size: 18px !important;
}

.navbar-sec a.navbar-brand img {
  border-radius: 6px;
}

.logout-btn a {
  color: var(--primary) !important;
  font-weight: 600 !important;
}

.logout-btn a:hover {
  color: var(--primary-dark) !important;
}

/* ---------- Animations ---------- */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.card {
  animation: fadeIn 0.3s ease forwards;
}

.content-wrapper .row .col-sm-12 {
  animation: fadeIn 0.4s ease forwards;
}
